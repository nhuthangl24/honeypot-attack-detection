[Unit]
Description=Beelzebub SOC Dashboard and Log Parser
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=nhuthang
WorkingDirectory=/opt/beelzebub-dashboard
Environment=BEELZEBUB_CONTAINER=beelzebub
Environment=LOG_SINCE=5m
Environment=PORT=8080
ExecStart=/opt/beelzebub-dashboard/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
