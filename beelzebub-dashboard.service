[Unit]
Description=Beelzebub ML Detection Engine and SOC Dashboard (VM 2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/beelzebub-dashboard
Environment=PORT=8080
ExecStart=/opt/beelzebub-dashboard/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
